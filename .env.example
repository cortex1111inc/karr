# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection for Drizzle (Project Settings → Database → Connection string → URI)
# Use the "Transaction pooler" URI for serverless/edge, "Session pooler" or direct for migrations.
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# Service role key (Project Settings → API) — server-side only, used by db/seed.ts
# and staff invites to manage auth users. Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used to build shareable links (booking pages, emailed
# quotes and invoices). Omit in production on Vercel; it falls back to VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fallback email (Resend) for orgs that haven't connected their own on
# /integrations. Without these, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=

# Encrypts integration credentials (e.g. email API keys) before storing
# them in the database via the Integrations page. Required for that page to
# work — generate with `openssl rand -hex 32`. Changing this value after
# credentials are saved makes them undecryptable (reconnect the integration).
INTEGRATIONS_ENCRYPTION_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when calling
# /api/cron/*. Set the same value here and in Vercel's project env vars. Optional
# locally — the cron route allows unauthenticated calls if this is unset.
CRON_SECRET=
