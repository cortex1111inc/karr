# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection for Drizzle (Project Settings → Database → Connection string → URI)
# Use the "Transaction pooler" URI for serverless/edge, "Session pooler" or direct for migrations.
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres

# Service role key (Project Settings → API) — server-side only, used by db/seed.ts
# and staff invites to manage auth users. Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL — used to build shareable links (booking confirmations, WhatsApp
# messages). Omit in production on Vercel; it falls back to VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api/get-started).
# Optional — without these, outbound WhatsApp messages are logged to the console and to
# the whatsapp_messages table instead of actually sent, so the app still works end to end.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when calling
# /api/cron/*. Set the same value here and in Vercel's project env vars. Optional
# locally — the cron route allows unauthenticated calls if this is unset.
CRON_SECRET=
